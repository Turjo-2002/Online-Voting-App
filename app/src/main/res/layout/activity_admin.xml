<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/btnAddCandidate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Candidate"/>

    <Button
        android:id="@+id/btnUpdateCandidate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Candidate"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnDeleteCandidate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete Candidate"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btn_view_voters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Voters"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnPublishResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Publish Result"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnPreviewResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preview Result"
        android:layout_marginTop="10dp"/>

</LinearLayout>